# Copy these values into environment variables on the computer running the API.
# Get the host, username, and password from Supabase Dashboard > Connect > Session pooler.
DATABASE_URL=jdbc:postgresql://aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=replace-with-your-supabase-database-password
